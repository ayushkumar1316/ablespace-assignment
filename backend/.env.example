# ── Local Development ──────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# All variables have sensible local defaults; only JWT_SECRET is
# truly required (the server crashes without it).

# Server
PORT=4000

# Database — local MongoDB (start mongod before launching the backend)
MONGODB_URI=mongodb://localhost:27017/ablespace

# Auth
JWT_SECRET=ablespace-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000

# ── Production (Render / Railway / etc.) ───────────────────────────
# Set these as environment variables on your hosting platform.
# Do NOT commit real values to version control.
#
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/ablespace
# JWT_SECRET=<generate with: openssl rand -hex 32>
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://<your-vercel-app>.vercel.app
# PORT=4000  (or leave unset — most hosts assign one automatically)
