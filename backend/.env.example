# Server
PORT=4000

# Database (local MongoDB — start mongod before launching the backend)
MONGODB_URI=mongodb://localhost:27017/ablespace
# For Atlas, replace the line above with:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/ablespace

# Auth — required. Generate a long random string for production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000
